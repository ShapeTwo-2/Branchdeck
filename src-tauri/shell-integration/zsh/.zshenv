# Branchdeck shell integration for zsh (ZDOTDIR shim). Generated by Branchdeck.
# Each shim file loads your real file with ZDOTDIR pointing at your directory,
# then points ZDOTDIR back here so zsh reads the next shim file.
__bd_shim_dir=$ZDOTDIR
ZDOTDIR=${BRANCHDECK_USER_ZDOTDIR:-$HOME}
unset BRANCHDECK_USER_ZDOTDIR
[[ -f $ZDOTDIR/.zshenv ]] && . "$ZDOTDIR/.zshenv"
__bd_user_zdotdir=$ZDOTDIR
ZDOTDIR=$__bd_shim_dir
