# Branchdeck shell integration for zsh. Generated by Branchdeck.
ZDOTDIR=$__bd_user_zdotdir
[[ -f $ZDOTDIR/.zshrc ]] && . "$ZDOTDIR/.zshrc"
__bd_user_zdotdir=$ZDOTDIR

# Reports the last exit code and cwd via an invisible escape sequence (OSC 6973).
typeset -g __bd_nonce="$BRANCHDECK_NONCE"
unset BRANCHDECK_NONCE
__bd_precmd() {
  local ec=$?
  printf '\033]6973;P;%s;%s;%s\007' "$__bd_nonce" "$ec" "$PWD"
  return $ec
}
if [[ -n $__bd_nonce ]]; then
  # First in the list so it sees the real exit code.
  precmd_functions=(__bd_precmd $precmd_functions)
fi

if [[ -o login ]]; then
  ZDOTDIR=$__bd_shim_dir   # .zlogin still to come; it restores ZDOTDIR
else
  ZDOTDIR=$__bd_user_zdotdir
  unset __bd_shim_dir __bd_user_zdotdir
fi
